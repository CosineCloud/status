# Copy to .env and replace all three values before deploying.
# Generate each value with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
UPDATE_KEY=replace-with-a-long-random-admin-key
DASHBOARD_PIN=replace-with-a-long-random-dashboard-key
FLASK_SECRET=replace-with-a-long-random-session-secret
STATUS_SAMPLE_SECS=10
PORT=8000
